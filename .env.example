# Aetheria Environment Variables Example

# FastAPI Configuration
PROJECT_NAME="Palmistry & Tarot Intelligence Platform"
PORT=8000

# Security (Change this in production!)
JWT_SECRET=AETHERIA_MYSTIC_JWT_SECRET_KEY_FOR_LOCAL_DEV_0987654321

# Database Configuration
# Use SQLite locally out of the box, or swap to PostgreSQL in production
DATABASE_URL=sqlite:///./aetheria_sqlite.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/aetheria

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/aetheria

# AI Model Integration (Leave blank to use built-in offline Demo Mode)
OPENAI_API_KEY=
